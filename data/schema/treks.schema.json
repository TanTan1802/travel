{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "treks.schema.json",
  "title": "Cung trekking",
  "description": "Các cung trekking: độ khó, quãng đường, lịch trình từng ngày, chi phí, an toàn. Chuỗi hai ngôn ngữ [tiếng Việt, English].",
  "type": "object",
  "required": ["levels", "treks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "levels": {
      "type": "object",
      "required": ["easy", "moderate", "hard", "expert"],
      "additionalProperties": false,
      "patternProperties": {
        "^(easy|moderate|hard|expert)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["icon", "label", "desc"],
          "properties": {
            "icon": { "$ref": "common.schema.json#/$defs/icon" },
            "label": { "$ref": "common.schema.json#/$defs/pair" },
            "desc": { "$ref": "common.schema.json#/$defs/pair" }
          }
        }
      }
    },
    "treks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "province", "region", "near", "level", "days", "distanceKm", "distanceNote", "summit", "bestMonths", "guide", "start", "end", "highlights", "plan", "costs", "safety", "updated"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "$ref": "common.schema.json#/$defs/pair" },
          "province": { "$ref": "common.schema.json#/$defs/pair" },
          "region": { "type": "string", "enum": ["bac", "trung", "nam"] },
          "near": { "description": "Điểm đến gần (mã trong destinations.json) – trang điểm đến hiện mục Trekking quanh đây", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } },
          "level": { "type": "string", "enum": ["easy", "moderate", "hard", "expert"] },
          "days": { "description": "Số ngày đi bộ; plan có đúng chừng ấy mục", "type": "integer", "minimum": 1, "maximum": 7 },
          "distanceKm": { "description": "Quãng đường đi bộ [thấp, cao] km – các nguồn thường lệch nhau", "type": "array", "prefixItems": [{ "type": "number", "minimum": 0 }, { "type": "number", "minimum": 0 }], "minItems": 2, "maxItems": 2 },
          "distanceNote": { "$ref": "common.schema.json#/$defs/pair" },
          "summit": { "description": "Độ cao điểm cao nhất (m), null nếu không leo đỉnh", "type": ["integer", "null"], "minimum": 0, "maximum": 3200 },
          "bestMonths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/month" } },
          "guide": { "description": "required = bắt buộc / thực tế phải đi cùng người dẫn đường; recommended = nên thuê", "type": "string", "enum": ["required", "recommended"] },
          "start": { "$ref": "common.schema.json#/$defs/pair" },
          "end": { "$ref": "common.schema.json#/$defs/pair" },
          "notice": { "description": "Quy định / thông báo cần biết (cấm đi tự phát, đăng ký…)", "$ref": "common.schema.json#/$defs/pair" },
          "images": { "description": "Ảnh của chính cung trên Wikimedia Commons (ảnh đầu là ảnh bìa, ảnh sau dự phòng); bỏ trống = dùng ảnh điểm đến gần", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/imageFile" } },
          "highlights": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/pair" } },
          "plan": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "text"],
              "properties": { "title": { "$ref": "common.schema.json#/$defs/pair" }, "text": { "$ref": "common.schema.json#/$defs/pair" } }
            }
          },
          "costs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/pair" } },
          "safety": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/pair" } },
          "updated": { "$ref": "common.schema.json#/$defs/yearMonth" }
        }
      }
    }
  }
}
