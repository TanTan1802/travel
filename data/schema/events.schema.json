{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "Lễ hội, mùa cảnh sắc, nghỉ lễ và thời tiết cần lưu ý",
  "description": "Mỗi sự kiện có đúng một trong dates (['MM-DD','MM-DD'] dương lịch cố định) hoặc months (tháng gần đúng, dùng cho lễ âm lịch và các mùa).",
  "type": "object",
  "required": ["eventTypes", "events"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "eventTypes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["icon", "label"],
        "properties": { "icon": { "$ref": "common.schema.json#/$defs/icon" }, "label": { "$ref": "common.schema.json#/$defs/pair" } }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "where", "type", "name", "desc", "tip"],
        "oneOf": [{ "required": ["dates"] }, { "required": ["months"] }],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "where": {
            "oneOf": [
              { "const": "all" },
              { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } }
            ]
          },
          "type": { "type": "string", "enum": ["festival", "nature", "holiday", "weather"] },
          "dates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" }
          },
          "months": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/month" } },
          "lunar": { "type": "boolean" },
          "name": { "$ref": "common.schema.json#/$defs/pair" },
          "desc": { "$ref": "common.schema.json#/$defs/pair" },
          "tip": { "$ref": "common.schema.json#/$defs/pair" }
        }
      }
    }
  }
}
