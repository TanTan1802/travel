      "description": "海拔 1000 多米的高原，四季凉爽，以心形茶山、李子谷、11–12 月的白色芥菜花和早春的李花、桃花闻名。距河内仅约 200 公里，是理想的周末去处。"
    },
    "pu-luong": {
      "name": "普隆",
      "province": "清化",
      "tagline": "梯田、水车与宁静的泰族村寨",
      "bestTime": "5 月 – 6 月，9 月 – 10 月",
      "duration": "2 – 3 天",
      "highlights": [
        "东村梯田",
        "富团水车",
        "孝瀑布",
        "科芒村"
      ],
      "description": "普隆自然保护区有原始森林、壮阔的梯田，以及保留传统高脚屋的泰族、芒族村寨。非常适合徒步、在稻田间住民宿，在竹水车吱呀声中入眠。"
    },
    "ly-son": {
      "name": "李山岛",
      "province": "广义",
      "tagline": "大海中的大蒜王国",
      "bestTime": "3 月 – 8 月",
      "duration": "2 – 3 天",
      "highlights": [
        "多和拱门",
        "泰来峰",
        "杭寺",
        "小岛（Đảo Bé）"
      ],
      "description": "这是一座火山岛，有翠绿的大蒜田、陡峭的玄武岩悬崖和小岛周围清澈见底的海水。李山岛至今保留着“犒赏黄沙兵”祭礼——庄严纪念守卫群岛的士兵。"
    },
    "buon-ma-thuot": {
      "name": "邦美蜀",
      "province": "多乐",
      "tagline": "越南咖啡之都与西原",
      "bestTime": "11 月 – 3 月",
      "duration": "2 – 3 天",
      "highlights": [
        "世界咖啡博物馆",
        "德雷努瀑布",
        "勒湖",
        "邦敦"
      ],
      "description": "坐落在红色玄武岩高原上的城市，被誉为越南咖啡之都。从这里出发，可探访壮观的德雷努瀑布、勒湖、埃地族和墨侬族村落，以及被列为联合国教科文组织非物质文化遗产的西原锣钲文化。"
    },
    "ha-tien": {
      "name": "河仙",
      "province": "坚江",
      "tagline": "泰国湾畔温柔的边境小城",
      "bestTime": "11 月 – 4 月",
      "duration": "2 – 3 天",
      "highlights": [
        "鹿岬海滩",
        "石洞",
        "东湖",
        "海贼群岛"
      ],
      "description": "这里是“河仙十景”之乡：石灰岩山丘、洞穴、东湖和鹿岬海滩。河仙也是前往海贼群岛、富国岛和柬埔寨的门户，越南、华人和高棉文化在此交汇。"
    },
    "tay-ninh": {
      "name": "西宁 – 黑婆山",
      "province": "西宁",
      "tagline": "南部屋脊与高台教圣座",
      "bestTime": "12月 – 4月",
      "duration": "1 – 2 天",
      "highlights": [
        "黑婆山",
        "高台教圣座",
        "油汀湖",
        "南方中央局基地"
      ],
      "description": "西宁距胡志明市约 100 公里，拥有海拔 986 米、被称为“南部屋脊”的黑婆山：乘缆车登顶，可参拜灵验的婆寺建筑群，欣赏云海之上的西补陀山佛像。造型独特、仪式庄严的高台教圣座是独一无二的体验，当地的露晒米纸和虾盐也很有名。"
    },
    "ninh-thuan": {
      "name": "宁顺 – 永熙",
      "province": "宁顺",
      "tagline": "阳光、海风、葡萄园与古占塔",
      "bestTime": "1月 – 8月",
      "duration": "2 – 3 天",
      "highlights": [
        "永熙湾",
        "波克朗加莱塔",
        "主山国家公园",
        "水獭洞"
      ],
      "description": "宁顺是越南阳光最充足、风最大的地方之一：清澈的永熙湾、穿越主山国家公园的海滨公路、南强沙丘和硕果累累的葡萄园。这里也是占族文化的中心，有古老的波克朗加莱塔、包竹陶村和多彩的卡特节。"
    }
  },
