{
  "name": "viet-travel",
  "private": true,
  "description": "Website khám phá danh lam thắng cảnh Việt Nam",
  "scripts": {
    "images": "node tools/download-images.js && node tools/optimize-images.js",
    "check-images": "node tools/check-images.js",
    "build": "node tools/build.js",
    "serve": "python3 -m http.server 8000",
    "test": "npm run test:data && npm run test:e2e",
    "test:data": "node --test tests/data.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "playwright": "^1.56.1"
  }
}
